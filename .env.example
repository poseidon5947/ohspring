# Copy to .env; never commit real credentials.
DATABASE_PASSWORD=replace-with-a-strong-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
# Set COOKIE_SECURE=true and an HTTPS PUBLIC_URL in production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_LIVE=false
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_LIVE=false
LLAVE_KEY=
LLAVE_BENEFICIARY=
WISE_PAYMENT_URL=
# Optional trusted bank reconciliation bridge for Llave / Wise (at least 32 characters).
BANK_WEBHOOK_SECRET=

# Optional private Supabase Storage bucket; omit for database-backed local attachments.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
